#!/bin/bash
# 🛡️ Auto-Repair de Estados - Zero Trust Validation
# Verifica y corrige estados inconsistentes automáticamente
# Ejecutar cada 5-10 minutos vía cron

WORKSPACE="/home/overgon/.openclaw/workspace"
LOGS="/home/overgon/.openclaw/logs"
SECRETS="/home/overgon/.openclaw/secrets"
BINANCE="https://api.binance.com"

source "$SECRETS/binance.env"

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOGS/auto-repair.log"
}

get_signature() {
    echo -n "$1" | openssl dgst -sha256 -hmac "$BINANCE_API_SECRET" | awk '{print $2}'
}

get_balance() {
    local symbol="$1"
    local timestamp=$(date -u +%s%3N)
    local query_string="timestamp=${timestamp}&recvWindow=5000"
    local signature=$(get_signature "$query_string")
    local result=$(curl -s -X GET "${BINANCE}/api/v3/account?${query_string}&signature=${signature}" -H "X-MBX-APIKEY: ${BINANCE_API_KEY}")
    echo "$result" | jq -r ".balances[] | select(.asset == \"$symbol\") | {free: .free, locked: .locked}"
}

check_order_status() {
    local symbol="$1"
    local order_id="$2"
    local timestamp=$(date -u +%s%3N)
    local query_string="symbol=${symbol}USDT&orderId=${order_id}&timestamp=${timestamp}&recvWindow=5000"
    local signature=$(get_signature "$query_string")
    local result=$(curl -s -X GET "${BINANCE}/api/v3/order?${query_string}&signature=${signature}" -H "X-MBX-APIKEY: ${BINANCE_API_KEY}")
    echo "$result" | jq -r '.status'
}

send_telegram() {
    local message="$1"
    local config_file="$HOME/.openclaw/openclaw.json"
    local chat_id="7543955537"
    
    # Leer token desde channels.telegram.botToken en openclaw.json
    local bot_token=""
    if [ -f "$config_file" ]; then
        bot_token=$(jq -r '.channels.telegram.botToken // empty' "$config_file" 2>/dev/null)
    fi
    
    # Fallback a variable de entorno
    if [ -z "$bot_token" ]; then
        bot_token="${TELEGRAM_BOT_TOKEN:-}"
    fi
    
    if [ -n "$bot_token" ] && [ "$bot_token" != "null" ]; then
        curl -s -X POST "https://api.telegram.org/bot${bot_token}/sendMessage" \
            -H "Content-Type: application/json" \
            -d "{\"chat_id\":\"${chat_id}\",\"text\":\"$message\",\"parse_mode\":\"Markdown\"}" > /dev/null
    fi
}

auto_repair_coin() {
    local symbol="$1"
    local state_file="$WORKSPACE/crypto-bots/${symbol}-trade-state.json"
    
    if [ ! -f "$state_file" ]; then
        log "⚠️ $symbol: No existe state file, saltando..."
        return 0
    fi
    
    log "🔍 $symbol: Validando estado..."
    
    local status=$(jq -r '.status' "$state_file")
    local type=$(jq -r '.type' "$state_file")
    local balance_info=$(get_balance "$symbol")
    local balance_free=$(echo "$balance_info" | jq -r '.free // "0"')
    local balance_locked=$(echo "$balance_info" | jq -r '.locked // "0"')
    
    log "  $symbol: Estado=$status, Tipo=$type, Free=$balance_free, Locked=$balance_locked"
    
    local repaired=false
    
    # CASO 0: CLOSED_SL o CLOSED_TP → RESET A READY (trade ya cerró, listo para operar)
    if [[ "$status" == "CLOSED_SL" || "$status" == "CLOSED_TP" || "$status" == "CLOSED_MANUAL" ]]; then
        log "✅ $symbol: Estado $status es consistente (trade cerrado)"
        log "🔧 $symbol: Auto-Repair → READY (listo para nuevo trade)"
        
        jq --arg now "$(date -Iseconds)" \
           '.status = "READY" | .type = "NONE" | .orderId = null | .entryPrice = null | .quantity = null | .autoRepaired = true | .autoRepairedAt = $now | .autoRepairReason = "closed_state_to_ready"' \
           "$state_file" > /tmp/state_${symbol}.json && mv /tmp/state_${symbol}.json "$state_file"
        
        repaired=true
        send_telegram "🔧 *AUTO-REPAIR - $symbol*

Estado: $status → READY

Trade cerrado, listo para operar.

🛡️ Zero Trust - Auto-corregido"
    fi
    
    # CASO 0.5: CLOSED_TP2 o CLOSED_TRAILING → RESET AUTOMÁTICO DESPUÉS DE 20 MIN
    if [[ "$status" == "CLOSED_TP2" || "$status" == "CLOSED_TRAILING" ]]; then
        local slot_timestamp=$(jq -r '.timestamp // null' "$state_file")
        if [ "$slot_timestamp" != "null" ] && [ -n "$slot_timestamp" ]; then
            local slot_epoch=$(date -d "$slot_timestamp" +%s 2>/dev/null || echo "0")
            local current_epoch=$(date +%s)
            local minutes_closed=$(( (current_epoch - slot_epoch) / 60 ))
            
            if [ "$minutes_closed" -ge 20 ]; then
                log "🕐 $symbol: Estado $status cerrado por ${minutes_closed}min (threshold: 20min)"
                log "🔧 $symbol: Auto-Repair → READY (auto-reset después de 20min)"
                
                jq --arg now "$(date -Iseconds)" \
                   '.status = "READY" | .type = null | .orderId = null | .entryPrice = null | .quantity = null | .usdtSpent = null | .feeBuy = null | .totalCost = null | .stopLoss = null | .tp1 = null | .tp2 = null | .tp3 = null | .tp1Done = false | .tp2Done = false | .tp3Done = false | .highestPrice = null | .trailingStop = null | .trailingPercent = null | .timestamp = null | .autoRepaired = true | .autoRepairedAt = $now | .autoRepairReason = "'$status'_timeout_20min"' \
                   "$state_file" > /tmp/state_${symbol}.json && mv /tmp/state_${symbol}.json "$state_file"
                
                repaired=true
                send_telegram "🔧 *AUTO-REPAIR - $symbol*

Estado: $status → READY

Tiempo cerrado: ${minutes_closed} minutos
Threshold: 20 minutos

✅ Auto-reset completado - Listo para operar"
            else
                log "⏳ $symbol: Estado $status cerrado por ${minutes_closed}min (< 20min, esperando)"
            fi
        else
            log "⚠️ $symbol: Estado $status sin timestamp, no se puede calcular tiempo"
        fi
    fi
    
    # CASO 1: CLOSED_MANUAL pero hay balance → RESET A READY (legacy check)
    if [ "$status" = "CLOSED_MANUAL" ] && (( $(echo "$balance_free > 0" | bc -l) )); then
        log "⚠️ $symbol: CLOSED_MANUAL pero hay balance ($balance_free)"
        log "🔧 $symbol: Auto-Repair → READY"
        
        jq --arg now "$(date -Iseconds)" \
           '.status = "READY" | .type = "NONE" | .orderId = null | .entryPrice = null | .quantity = null | .closeReason = null | .autoRepaired = true | .autoRepairedAt = $now | .autoRepairReason = "CLOSED_MANUAL_with_balance"' \
           "$state_file" > /tmp/state_${symbol}.json && mv /tmp/state_${symbol}.json "$state_file"
        
        send_telegram "🔧 *AUTO-REPAIR - $symbol*

Estado inconsistente detectado y corregido

*Estado Anterior:* CLOSED_MANUAL
*Estado Nuevo:* READY
*Balance Detectado:* $balance_free $symbol

✅ Sistema auto-reparado - Operativo"
        
        repaired=true
    fi
    
    # CASO 2: ACTIVE pero balance_locked = 0 → Verificar orden
    if [ "$status" = "ACTIVE" ] && (( $(echo "$balance_locked == 0" | bc -l) )); then
        local order_id=$(jq -r '.orderId // null' "$state_file")
        if [ "$order_id" != "null" ] && [ -n "$order_id" ]; then
            local order_status=$(check_order_status "$symbol" "$order_id")
            log "  $symbol: Orden $order_id status = $order_status"
            
            if [ "$order_status" = "CANCELLED" ] || [ "$order_status" = "EXPIRED" ] || [ "$order_status" = "REJECTED" ]; then
                log "⚠️ $symbol: Orden $order_status → Reset a READY"
                
                jq --arg now "$(date -Iseconds)" \
                   '.status = "READY" | .type = "NONE" | .orderId = null | .autoRepaired = true | .autoRepairedAt = $now | .autoRepairReason = "order_'$order_status'"' \
                   "$state_file" > /tmp/state_${symbol}.json && mv /tmp/state_${symbol}.json "$state_file"
                
                send_telegram "🔧 *AUTO-REPAIR - $symbol*

Orden cancelada/expirada detectada

*Orden ID:* $order_id
*Estado Orden:* $order_status
*Acción:* Reset a READY

✅ Sistema auto-reparado"
                
                repaired=true
            fi
        fi
    fi
    
    # CASO 3: WAITING_BUYBACK con balance suficiente → Cerrar
    if [ "$status" = "WAITING_BUYBACK" ] && (( $(echo "$balance_free > 0" | bc -l) )); then
        local expected_qty=$(jq -r '.quantity // "0"' "$state_file")
        if (( $(echo "$balance_free >= $expected_qty * 0.9" | bc -l) )); then
            log "⚠️ $symbol: WAITING_BUYBACK pero balance suficiente"
            log "🔧 $symbol: Actualizando a CLOSED_SL"
            
            jq --arg now "$(date -Iseconds)" \
               '.status = "CLOSED_SL" | .closeReason = "AUTO_REPAIRED_BUYBACK" | .closedAt = $now | .autoRepaired = true | .autoRepairedAt = $now' \
               "$state_file" > /tmp/state_${symbol}.json && mv /tmp/state_${symbol}.json "$state_file"
            
            send_telegram "🔧 *AUTO-REPAIR - $symbol*

Buyback completado detectado

*Balance:* $balance_free $symbol
*Esperado:* $expected_qty $symbol
*Acción:* Estado actualizado a CLOSED_SL

✅ Sistema auto-reparado"
            
            repaired=true
        fi
    fi
    
    if [ "$repaired" = false ]; then
        log "✅ $symbol: Estado consistente"
    fi
}

# ============================================
# MAIN
# ============================================

log "🛡️ === AUTO-REPAIR START ==="

# Lista de coins a verificar
COINS=("BTC" "ETH" "BNB" "SOL" "LINK" "XRP")

for coin in "${COINS[@]}"; do
    auto_repair_coin "$coin"
done

log "🛡️ === AUTO-REPAIR COMPLETE ==="
