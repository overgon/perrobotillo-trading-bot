# ╔═══════════════════════════════════════════════════════╗
# ║  🛡️ .gitignore - Perrobotillo Trading Bot             ║
# ║  NUNCA subir secrets, API keys o datos sensibles      ║
# ╚═══════════════════════════════════════════════════════╝

# ════════════════════════════════════════════════════════
# 🔐 SECRETS Y CREDENCIALES (CRÍTICO)
# ════════════════════════════════════════════════════════
secrets/
*.env
.env
.env.local
.env.*.local
binance.env
telegram.env
openclaw.json
*.key
*.pem
*.crt

# ════════════════════════════════════════════════════════
# 📊 DATOS DE TRADING EN TIEMPO REAL
# ════════════════════════════════════════════════════════
# Estados actuales de trades (contienen balances reales)
crypto-bots/*-trade-state.json
crypto-bots/*-daily-pnl.json
crypto-bots/portfolio-snapshot*.json
portfolio-snapshot*.json

# Logs con información sensible
logs/
*.log
!logs/.gitkeep

# ════════════════════════════════════════════════════════
# 🤖 OPENCLAW - CONFIGURACIÓN LOCAL
# ════════════════════════════════════════════════════════
.openclaw/
openclaw.json
workspace-state.json
*.bak
*.backup

# ════════════════════════════════════════════════════════
# 💾 ARCHIVOS DE ESTADO Y CACHE
# ════════════════════════════════════════════════════════
state/
.cache/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ════════════════════════════════════════════════════════
# 📝 MEMORIAS Y SESSIONES (datos personales)
# ════════════════════════════════════════════════════════
memory/
sessions/
*.md.tmp

# ════════════════════════════════════════════════════════
# 🗄️ ARCHIVO / HISTORIAL / CACHÉ
# ════════════════════════════════════════════════════════
.archive/
crypto-bots/daily-report-*
crypto-bots/monthly-report-*
cache/
state/
research/vibe-alpha/__pycache__/
*.bak
*.backup
*-trade-state.json.bak-*
*cashout-history.json.migrated*
cashout-history.json.v1-backup
trade-history.json.backup-*
openclaw-workspace-state.json
legacy/
research/paper_money_smoke.py
research/vibe-alpha/alpha101_054_v2.py
scripts/__pycache__/*
scripts/balance-now.sh
scripts/check-all-balances.py
scripts/cleanup-trade-state.sh
scripts/daily-report.py
scripts/sell-btc-rebalance.py
scripts/sell-xrp-rebalance.py
scripts/tp-monitor.sh.tmp
scripts/watchdog-bots-vivos.sh
tp-monitor.sh
ml/__pycache__/*
