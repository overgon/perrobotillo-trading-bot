ml/predictions_log.json
ml/tp-predictions.json
ml/tp-recommendations.json

# ════════════════════════════════════════════════════════
# ✅ LO QUE SÍ SE SUBE (explícitamente)
# ════════════════════════════════════════════════════════
# !.gitignore
# !README.md
# !SECURITY.md
# !INSTALL.md
# !config/*.sh (sin secrets)
# !crypto-bots/*.sh (scripts del bot)
# !*.md (documentación)

# === SECURITY: Runtime data nunca va en git ===
crypto-bots/.public_ip
crypto-bots/alerts-state.json
crypto-bots/capital-manager-progress.json
crypto-bots/cashout-history.json
crypto-bots/trade-history.json
crypto-bots/*-trade-state.json
*-trade-state.json.bak-*
dashboard/ssl/*.key

# ════════════════════════════════════════════════════════
# ML Param Multipliers (runtime generated)
# ════════════════════════════════════════════════════════
ml/param-multipliers.json
ml/models_optimized/param_multipliers/
*.pkl

# Runtime config (auto-generated by auto-adjust)
crypto-bots/dynamic-config.env
crypto-bots/market-mode.conf
