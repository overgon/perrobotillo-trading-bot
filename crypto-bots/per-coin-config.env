# ═══════════════════════════════════════════════════════════════════════════
# PER-COIN CONFIG — overrides por moneda (fuente autoritativa)
#
# El dashboard (dashboard/app.py) resuelve la config efectiva desde aquí y
# market-sentiment.sh copia estas claves a market-mode.conf, que es donde el
# bot (crypto-trade-moneda-v3-slots.sh) las lee.
#
# Claves: <COIN>_TP1, _TP2, _TP3, _STOP_LOSS (y _SL para el bot),
#         _POSITION_SIZE, _ML_MIN_CONFIDENCE, _TRAILING_STOP
# ═══════════════════════════════════════════════════════════════════════════

BTC_TP1=3.0
BTC_TP2=6.0
BTC_TP3=9.0
BTC_STOP_LOSS=3.5
BTC_SL=3.5
BTC_POSITION_SIZE=10
BTC_ML_MIN_CONFIDENCE=45

