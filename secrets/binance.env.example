# ════════════════════════════════════════════════════════
# 🔐 BINANCE API CREDENTIALS - EJEMPLO
# ════════════════════════════════════════════════════════
# ⚠️ ESTE ES UN ARCHIVO DE EJEMPLO
# ⚠️ COPIA ESTE ARCHIVO COMO binance.env Y COMPLETA CON TUS DATOS
# ⚠️ NUNCA subas binance.env a GitHub (está en .gitignore)
#
# Instrucciones:
# 1. Copia este archivo: cp binance.env.example binance.env
# 2. Edita binance.env con tus credenciales reales
# 3. chmod 600 binance.env
# ════════════════════════════════════════════════════════

# API Key de Binance (obténla en: https://www.binance.com/en/my/settings/api-management)
BINANCE_API_KEY="tu_api_key_aqui"

# Secret Key de Binance
BINANCE_SECRET_KEY="tu_secret_key_aqui"

# ════════════════════════════════════════════════════════
# 🌐 IP WHITELIST
# ════════════════════════════════════════════════════════
# Tu IP pública actual
# Para ver tu IP: curl https://api.ipify.org
# ⚠️ IMPORTANTE: Debes agregar esta IP en la whitelist de Binance
PUBLIC_IP="123.456.789.012"

# ════════════════════════════════════════════════════════
# 📊 CONFIGURACIÓN DE TRADING
# ════════════════════════════════════════════════════════

# Capital inicial para trading (USDT)
TRADING_CAPITAL=1100

# Porcentaje de riesgo por trade (1.0 = 1%)
RISK_PER_TRADE=1.0

# Stop Loss máximo diario (porcentaje del portfolio)
# Si el portfolio pierde este % en un día, el bot se detiene
MAX_DAILY_LOSS=3.0

# ════════════════════════════════════════════════════════
# 🔔 CONFIGURACIÓN DE ALERTAS
# ════════════════════════════════════════════════════════

# Email para alertas (opcional)
ALERT_EMAIL=""

# Nivel de drawdown para alerta temprana (porcentaje)
DRAWDOWN_ALERT_THRESHOLD=2.0
