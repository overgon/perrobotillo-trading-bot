# ════════════════════════════════════════════════════════
# 📱 TELEGRAM BOT CREDENTIALS - EJEMPLO
# ════════════════════════════════════════════════════════
# ⚠️ ESTE ES UN ARCHIVO DE EJEMPLO
# ⚠️ COPIA ESTE ARCHIVO COMO telegram.env Y COMPLETA CON TUS DATOS
# ⚠️ NUNCA subas telegram.env a GitHub (está en .gitignore)
#
# Instrucciones:
# 1. Crea un bot con @BotFather en Telegram
# 2. Copia este archivo: cp telegram.env.example telegram.env
# 3. Edita telegram.env con tus credenciales reales
# 4. chmod 600 telegram.env
# ════════════════════════════════════════════════════════

# Token del Bot (obténlo de @BotFather)
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz"

# Tu Chat ID (obténlo de @userinfobot)
TELEGRAM_CHAT_ID="123456789"

# ════════════════════════════════════════════════════════
# 🔔 CONFIGURACIÓN DE NOTIFICACIONES
# ════════════════════════════════════════════════════════

# Notificar cada trade abierto (true/false)
NOTIFY_TRADE_OPEN=true

# Notificar cada TP alcanzado (true/false)
NOTIFY_TP_HIT=true

# Notificar Stop Loss (true/false)
NOTIFY_SL_HIT=true

# Notificar reporte diario (true/false)
NOTIFY_DAILY_REPORT=true

# Notificar alertas de IP (true/false)
NOTIFY_IP_CHANGE=true

# Notificar drawdown alerts (true/false)
NOTIFY_DRAWDOWN_ALERT=true
